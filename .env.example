CLAN_TAG=#RQJGC9GV
CLASH_ROYALE_API_TOKEN=replace-with-your-api-token
POSTGRES_DB=frota_fantasma
POSTGRES_USER=frota_fantasma
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_PORT=5432
BACKEND_PORT=8080
FRONTEND_PORT=5173
CLASH_CONNECT_TIMEOUT=5s
CLASH_READ_TIMEOUT=10s
CLASH_MAX_ATTEMPTS=2
CLASH_RETRY_DELAY=500ms
CLASH_RATE_LIMIT_COOLDOWN=30s

# Coleta automática (cron no fuso configurado)
COLLECTION_ENABLED=true
COLLECTION_MEMBERS_INTERVAL=PT30M
COLLECTION_WAR_INTERVAL=PT15M
COLLECTION_LOG_INTERVAL=PT6H
COLLECTION_INITIAL_DELAY=PT10S
COLLECTION_TIMEZONE=UTC
COLLECTION_WAR_DAYS=THURSDAY,FRIDAY,SATURDAY,SUNDAY
COLLECTION_DAILY_CRON="0 5 0 * * *"
COLLECTION_WEEKLY_CRON="0 0 12 * * MON"
COLLECTION_MAX_PAGES=20

# Regras analíticas (sem ações automáticas)
ANALYTICS_POINTS_TARGET=1600
ANALYTICS_OFFLINE_DAYS=5
ANALYTICS_MINIMUM_WARS=4
ANALYTICS_IMMORTAL_MINIMUM_WARS=4
ANALYTICS_REVIEW_LOW_WARS=3
ANALYTICS_ADEQUATE_STANDARD_DECK_PERCENT=80
ANALYTICS_PROMOTION_TENURE_DAYS=28
ANALYTICS_PROMOTION_DONATIONS=100
ANALYTICS_FRESHNESS=PT2H
ANALYTICS_TIMEZONE=UTC

# Contas locais (senhas de 16 a 72 caracteres, sem valores padrão)
AUTH_ADMIN_USERNAME=lider
AUTH_ADMIN_PASSWORD=replace-with-a-unique-long-password
# Opcional: consulta sem permissões para alterações
AUTH_VIEWER_USERNAME=
AUTH_VIEWER_PASSWORD=
# true quando servido por HTTPS
SESSION_COOKIE_SECURE=false

# Backup: dono dos arquivos no host (ajuste conforme id -u / id -g)
BACKUP_UID=1000
BACKUP_GID=1000
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
